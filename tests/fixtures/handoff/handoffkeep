#!/usr/bin/env python3
"""Stand-in for the handoffkeep CLI. It keeps the flag rules of the installed binary, so a
command the real CLI refuses (--expected, a decision doc, no --project) fails here too.
State lives in $HK_STUB_STATE. $HK_STUB_FAIL_EXPORT makes one state's export fail, and
$HK_STUB_TRUNCATE_EXPORT and $HK_STUB_NO_COUNTS change what export reports, and
$HK_STUB_CORRUPT_DOC changes what doc get returns."""
import json
import os
import re
import sys
from pathlib import Path

STATE = Path(os.environ["HK_STUB_STATE"])
TASK_KINDS = {"implement", "verify", "fix", "decide", "ops"}
TASK_STATES = {"backlog", "claimed", "in_progress", "hold", "needs_decision", "verifying", "join", "reopened", "merged", "dropped"}
DOC_KINDS = {"brief", "report", "answer", "handoff", "note", "other"}
PROJECTS = {"fleet-ops"}
BODY_DOC = re.compile(r"^[A-Za-z0-9._\-/]{1,512}(#[^\s#]{1,200})?$")


def die(message):
    print(f"handoffkeep: {message}", file=sys.stderr)
    sys.exit(1)


def parse(args, allowed):
    flags, positional = {}, []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg.startswith("--"):
            name = arg[2:]
            if name not in allowed:
                die(f"flag provided but not defined: -{name}")
            if i + 1 >= len(args):
                die(f"flag needs an argument: -{name}")
            flags[name] = args[i + 1]
            i += 2
        else:
            positional.append(arg)
            i += 1
    return flags, positional


def task_id(positional):
    if len(positional) != 1 or not positional[0].isdigit():
        die("task command requires id")
    return int(positional[0])


def main(argv):
    state = json.loads(STATE.read_text()) if STATE.exists() else {"tasks": [], "comments": [], "docs": {}}
    if argv[:2] == ["tasks", "add"]:
        flags, positional = parse(argv[2:], {"lane", "project", "kind", "title", "doc"})
        if positional:
            die("tasks add takes flags only")
        if flags.get("project") not in PROJECTS:
            die("tasks add requires --project <name> (the allowed set is listed by tasks projects)")
        if not flags.get("lane") or not flags.get("title") or flags.get("kind", "implement") not in TASK_KINDS:
            die("invalid_context: tasks add requires --lane and --title and a known --kind")
        if "doc" in flags and not BODY_DOC.match(flags["doc"]):
            die("--doc must be a document key or key#section")
        task = {"id": 1000 + len(state["tasks"]), "state": "backlog", "lane": flags["lane"], "project": flags["project"],
                "kind": flags.get("kind", "implement"), "title": flags["title"], "body_doc": flags.get("doc", "")}
        state["tasks"].append(task)
        print(json.dumps(task))
    elif argv[:2] == ["tasks", "export"]:
        flags, _ = parse(argv[2:], {"state", "limit"})
        if flags.get("state") not in TASK_STATES:
            die("invalid_export_query: unknown state")
        if os.environ.get("HK_STUB_FAIL_EXPORT") == flags["state"]:
            die("export failed")
        tasks = [t for t in state["tasks"] if t["state"] == flags["state"]]
        row = {"tasks": tasks, "counts": {"total": len(tasks) + (1 if os.environ.get("HK_STUB_TRUNCATE_EXPORT") else 0)}}
        if os.environ.get("HK_STUB_NO_COUNTS"):
            del row["counts"]
        print(json.dumps(row))
    elif argv[:2] == ["tasks", "comment"]:
        flags, positional = parse(argv[2:], {"body"})
        if not flags.get("body"):
            die("tasks comment requires exactly one of --body or --file")
        state["comments"].append({"task_id": task_id(positional), "body": flags["body"]})
        print("{}")
    elif argv[:2] == ["tasks", "comments"]:
        _, positional = parse(argv[2:], {"limit"})
        wanted = task_id(positional)
        print(json.dumps({"comments": [c for c in state["comments"] if c["task_id"] == wanted]}))
    elif argv[:2] == ["tasks", "show"]:
        _, positional = parse(argv[2:], set())
        wanted = task_id(positional)
        for task in state["tasks"]:
            if task["id"] == wanted:
                print(json.dumps(task))
                break
        else:
            die("not_found")
    elif argv[:2] == ["doc", "put"]:
        flags, _ = parse(argv[2:], {"key", "kind", "file"})
        if flags.get("kind", "note") not in DOC_KINDS:
            die("invalid document")
        state["docs"][flags["key"]] = Path(flags["file"]).read_text()
        print("{}")
    elif argv[:2] == ["doc", "get"]:
        _, positional = parse(argv[2:], set())
        if positional[0] not in state["docs"]:
            die("not_found")
        body = state["docs"][positional[0]]
        if os.environ.get("HK_STUB_CORRUPT_DOC"):
            body = body[: len(body) // 2]
        print(json.dumps({"key": positional[0], "body": body}))
    else:
        die(f"unsupported command: {' '.join(argv[:2])}")
    STATE.write_text(json.dumps(state))


main(sys.argv[1:])
