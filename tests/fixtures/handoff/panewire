#!/usr/bin/env python3
"""Stand-in for panewire emit. It keeps the installed binary's refusals: --event-id is required
and a repeated id is an error. Accepted calls go to $PANEWIRE_STUB_LOG, one line each.
$PANEWIRE_STUB_ROOT_MISMATCH reproduces a shell whose default inbox differs from the daemon's."""
import os
import sys
from pathlib import Path

args = sys.argv[1:]
log = Path(os.environ["PANEWIRE_STUB_LOG"])


def refuse(message):
    print(f"emit: {message}", file=sys.stderr)
    sys.exit(2)


if args[:1] != ["emit"]:
    refuse(f"unsupported command: {args[:1]}")
event_id = args[args.index("--event-id") + 1] if "--event-id" in args else ""
if not event_id:
    refuse("invalid --event-id")
# Like the real binary, the record is kept before the daemon is asked, so a retry of the same
# id is refused as a duplicate even when the first attempt never reached the desk.
attempts = log.with_suffix(".attempts")
seen = attempts.read_text().splitlines() if attempts.exists() else []
if event_id in seen:
    refuse("duplicate event_id")
with attempts.open("a") as handle:
    handle.write(event_id + "\n")
if os.environ.get("PANEWIRE_STUB_ROOT_MISMATCH"):
    refuse("inbox root mismatch (daemon=/a, given=/b)")
with log.open("a") as handle:
    handle.write(" ".join(args) + "\n")
